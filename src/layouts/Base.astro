---
/**
 * Base.astro —— 全站骨架
 * - 首帧防闪烁主题（内联，在 CSS 之前）
 * - masthead（等宽机器层导航）+ 反转黑块页脚（构建遥测）
 * - 可选阅读进度条（文章页）
 */
import '../styles/tokens.css';
import '../styles/vendor/katex.min.css';
import '../styles/global.css';
import { SITE, BASE, siteStats, fmtTokens } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  progress?: boolean;
}

const { title, description = SITE.desc, progress = false } = Astro.props;
const stats = await siteStats();
const buildHash = __BUILD_HASH__;

// 当前路径 → 高亮对应 nav 项（aria-current）
const path = Astro.url.pathname;
const homePath = BASE.replace(/\/$/, ''); // '/yet-another-ai-generated-blog'（无尾斜杠版）
const isHome = path === BASE || path === homePath;
const isAbout = path.startsWith(`${BASE}about`);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={`${BASE}rss.xml`} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 首帧防闪烁：CSS 之前读主题
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark')
            document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <div class="regmark tl" aria-hidden="true"></div>
    <div class="regmark tr" aria-hidden="true"></div>
    <div class="regmark bl" aria-hidden="true"></div>
    <div class="regmark br" aria-hidden="true"></div>

    <div class="page">
      <header class="masthead">
        <nav>
          <a href={BASE} aria-current={isHome ? 'page' : undefined}>HOME</a>
          <a href={`${BASE}about/`} aria-current={isAbout ? 'page' : undefined}>ABOUT</a>
          <a href={`${BASE}rss.xml`}>RSS</a>
          <button class="theme-toggle" type="button">DARK</button>
        </nav>
      </header>
      <p class="masthead-sub">co-authored by John</p>

      <main>
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="inner">
        <span class="build">
          TOTAL {String(stats.count).padStart(3, '0')} · {stats.chars.toLocaleString('en-US')} 字 ·{' '}
          {fmtTokens(stats.tokens)} TOK · build {buildHash} · 0 cookies
        </span>
      </div>
    </footer>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
