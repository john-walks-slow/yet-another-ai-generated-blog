{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers 静态资产（Pages 的新形态）：纯静态、零函数、免费层无限请求
  "name": "yet-another-ai-generated-blog",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // 未命中路径回退到构建出的 404.html
    "not_found_handling": "404-page",
    // Astro 目录式路由（/posts/xxx/）与自动尾斜杠匹配
    "html_handling": "auto-trailing-slash"
  }
}
